# ═══════════════════════════════════════════════
# OlympicMotion Banner Engine — VPS 环境变量配置
# 复制本文件为 .env，填入真实值，.env 不会被 git 提交
# 设置文件权限：chmod 600 .env
# ═══════════════════════════════════════════════

# ── YouTube 数据 API（拉取订阅数）────────────────
YOUTUBE_API_KEY=AIzaSy_你的API密钥
YOUTUBE_CHANNEL_ID=UC你的频道ID

# ── Banner 上传方式，二选一 ──────────────────────

# 方式 S：Session 文件（VPS 推荐，运行 interactive-login.mjs 自动生成）
# 无需手动填写，session 文件自动保存到 .session/ 目录

# 方式 A：Cookie 字符串（GitHub Actions 推荐）
# YOUTUBE_COOKIES=VISITOR_INFO1_LIVE=xxxx; SID=xxxx; ...

# 方式 B：OAuth API（仅 YouTube 合作伙伴账号可用）
# GOOGLE_CLIENT_ID=你的client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-你的密钥
# GOOGLE_REFRESH_TOKEN=1//你的refresh_token

# ── Session 加密密钥（强烈推荐，AES-256-GCM）────
# 生成命令：node scripts/encrypt-session.mjs --gen-key
SESSION_ENCRYPTION_KEY=

# ── 本地服务器端口（Banner 预览服务）──────────────
PORT=38291

# ── 即时更新守护进程配置 ────────────────────────
# 轮询间隔（分钟，最低 1，推荐 5）
POLL_INTERVAL_MINUTES=5

# Webhook 监听端口（用于接收 YouTube PubSubHubbub 推送）
WEBHOOK_PORT=47832

# OAuth 授权回调端口（vps-login.mjs 监听）
OAUTH_CALLBACK_PORT=52947

# Caddy 监听端口（HTTPS 高位端口，不占用 80，但保留 HTTPS）
# Caddy 加载外部证书，80 端口完全释放给证书续期脚本
CADDY_PORT=43443

# SSL 证书路径（Banner 域名 om.sospaic.top，由 acme.sh/certbot 管理）
SSL_CERT_FILE=/etc/letsencrypt/live/om.sospaic.top/fullchain.pem
SSL_KEY_FILE=/etc/letsencrypt/live/om.sospaic.top/privkey.pem

# 节点证书（域名 ny.sospaic.top，由外部脚本管理，本项目只监控文件变更）
NODE_DOMAIN=ny.sospaic.top
NODE_SSL_CERT_FILE=/root/ygkkkca/cert.crt
NODE_SSL_KEY_FILE=/root/ygkkkca/private.key
NODE_CERT_METHOD=external
# 节点证书文件更新后执行的重载命令（如 systemctl restart xray）
NODE_RELOAD_CMD=
# 内部记录上次处理时间（自动维护，无需手动填写）
NODE_CERT_LAST_HANDLED=0

# ── DNS API 密钥（证书续期用）────────────────────
# NameSilo（ny.sospaic.top 节点域名使用）
NAMESILO_KEY=
# Cloudflare（如有使用）
# CF_TOKEN=
# CF_KEY=
# CF_EMAIL=

# VPS 公网地址（填写后启用 PubSubHubbub 即时推送，秒级响应）
# 格式：https://你的域名
WEBHOOK_PUBLIC_URL=
